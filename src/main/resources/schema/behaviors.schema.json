{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://persona.invalid/schema/behaviors.schema.json",
  "title": "Persona behavior tree",
  "type": "object",
  "required": ["id", "scope", "root"],
  "additionalProperties": false,
  "properties": {
    "content-version": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "scope": { "enum": ["shared", "player"] },
    "root": { "$ref": "#/$defs/node" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]*$" },
    "anchor": {
      "type": "object",
      "required": ["world", "x", "y", "z"],
      "properties": { "world": {"type":"string"}, "x": {"type":"number"}, "y": {"type":"number"}, "z": {"type":"number"}, "yaw": {"type":"number"}, "pitch": {"type":"number"} }
    },
    "npc-behaviors": {
      "type": "object",
      "properties": { "shared-behavior": {"$ref":"#/$defs/id"}, "player-behavior": {"$ref":"#/$defs/id"}, "anchors": {"type":"object", "additionalProperties":{"$ref":"#/$defs/anchor"}} }
    },
    "node": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["sequence", "selector", "priority-selector", "parallel", "invert", "repeat", "retry", "timeout", "cooldown", "checkpoint", "condition", "action", "wait", "subtree"] },
        "children": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } },
        "child": { "$ref": "#/$defs/node" },
        "behavior": { "$ref": "#/$defs/id" },
        "condition": { "type": "string" },
        "action": { "type": "string" },
        "duration": { "oneOf": [{"type":"string"},{"type":"number","minimum":0}] },
        "times": { "type": "integer", "minimum": 1 },
        "forever": { "type": "boolean" },
        "success-threshold": { "type": "integer", "minimum": 1 },
        "failure-threshold": { "type": "integer", "minimum": 1 },
        "cancel-remaining": { "enum": ["always", "on-success", "on-failure", "never"] },
        "event": { "type": "string", "minLength": 1 },
        "consume": { "type": "boolean" },
        "key": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "quest": { "$ref": "#/$defs/id" },
        "state": { "enum": ["not-started", "active", "completed"] },
        "material": { "type": "string", "minLength": 1 },
        "amount": { "type": "number" },
        "value": {},
        "value-type": { "enum": ["string", "number", "boolean"] },
        "operator": { "enum": ["equals", "not-equals", "greater-than", "greater-than-or-equal", "less-than", "less-than-or-equal", "contains"] },
        "permission": { "type": "string", "minLength": 1 },
        "world": { "type": "string", "minLength": 1 },
        "chance": { "type": "number", "minimum": 0, "maximum": 1 },
        "visible": { "type": "boolean" },
        "scope": { "enum": ["player", "global", "npc"] },
        "ttl": { "oneOf": [{"type":"string"},{"type":"number","minimum":0}] },
        "script": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "radius": { "type": "number", "exclusiveMinimum": 0 },
        "source": { "$ref": "#/$defs/id" },
        "anchor": { "$ref": "#/$defs/id" },
        "destination": { "$ref": "#/$defs/id" },
        "arrival-distance": { "type": "number", "exclusiveMinimum": 0 },
        "speed": { "type": "number", "exclusiveMinimum": 0 },
        "pathfinding-range": { "type": "number", "exclusiveMinimum": 0 },
        "stuck-seconds": { "type": "number", "exclusiveMinimum": 0 },
        "stuck-action": { "enum": ["fail", "retry", "teleport"] },
        "stuck-retries": { "type": "integer", "minimum": 0 }
      },
      "allOf": [
        { "if": { "properties": { "type": { "enum": ["sequence", "selector", "priority-selector", "parallel"] } } }, "then": { "required": ["children"] } },
        { "if": { "properties": { "type": { "enum": ["invert", "repeat", "retry", "timeout", "cooldown", "checkpoint"] } } }, "then": { "required": ["child"] } },
        { "if": { "properties": { "type": { "const": "condition" } } }, "then": { "required": ["condition"] } },
        { "if": { "properties": { "type": { "enum": ["repeat", "retry"] }, "forever": { "const": true } }, "required": ["forever"] }, "then": { "not": { "required": ["times"] } } },
        { "if": { "properties": { "type": { "const": "action" } } }, "then": { "required": ["action"] } },
        { "if": { "properties": { "type": { "const": "subtree" } } }, "then": { "required": ["behavior"] } }
      ]
    }
  }
}
