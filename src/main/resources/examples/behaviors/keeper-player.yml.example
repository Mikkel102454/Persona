# One runtime of this tree exists for each player viewing this logical NPC.
content-version: 2
id: harbor:keeper-player
scope: player

root:
  id: personal-priorities
  type: priority-selector
  children:
    # Named API signal: persona.api().signal(npc, player, "leave-town", Map.of())
    - id: leave-town-reaction
      type: sequence
      children:
        - { id: leave-town-signal, type: condition, condition: event, event: signal:leave-town }
        - { id: remember-departure, type: action, action: remember, key: departed, value: true }

    - id: departed-presentation
      type: sequence
      children:
        - { id: departed-memory, type: condition, condition: memory, key: departed, value: true }
        - { id: hide-keeper, type: action, action: set-visible, visible: false }

    # Named API signal: persona.api().signal(npc, player, "kindness", Map.of())
    - id: kindness-reaction
      type: sequence
      children:
        - { id: kindness-signal, type: condition, condition: event, event: signal:kindness }
        - id: kindness-cooldown
          type: cooldown
          duration: 10s
          child:
            id: increase-trust
            type: action
            action: adjust-memory
            key: trust
            amount: 1

    - { id: festival-subtree, type: subtree, behavior: harbor:keeper-festival }

    # Once the walk completes, retain the private presentation without starting
    # another navigation operation on every evaluation.
    - id: arrived-overlook-presentation
      type: sequence
      children:
        - { id: arrived-overlook-memory, type: condition, condition: memory, key: arrived-overlook, value: true }
        - { id: retain-private-overlook, type: action, action: set-anchor, anchor: overlook }

    # At three trust points, transition at the shared actor's exact current position,
    # walk a viewer-private projection to the overlook, then remember completion.
    - id: trusted-presentation
      type: sequence
      children:
        - id: trusted-memory
          type: condition
          condition: memory
          key: trust
          operator: greater-than-or-equal
          value: 3
        - { id: begin-private-overlook, type: action, action: begin-private-presentation }
        - id: durable-private-walk
          type: checkpoint
          child:
            id: private-overlook
            type: action
            action: private-navigate
            destination: overlook
            arrival-distance: 1.5
            speed: 1.0
            pathfinding-range: 64
            stuck-seconds: 10
            stuck-action: retry
            stuck-retries: 2
        - { id: remember-overlook-arrival, type: action, action: remember, key: arrived-overlook, value: true }

    # A missing anchor value means: inherit the shared actor again.
    - { id: inherit-shared, type: action, action: set-anchor }
