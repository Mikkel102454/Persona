id: persona:builder-routine
scope: player
root:
  id: routine
  type: priority-selector
  children:
    - id: recently-helped
      type: sequence
      children:
        - { id: helped-condition, type: condition, condition: memory, key: helped, value: true }
        - { id: workshop, type: action, action: set-anchor, anchor: workshop }
    - { id: inherit, type: action, action: set-anchor }
