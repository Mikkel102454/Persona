content-version: 2
id: village:supplies
title: "Building Supplies"
phases:
  - id: deliver-logs
    objectives:
      - id: oak_logs
        type: deliver-item
        material: minecraft:oak_log
        amount: 10
    on-complete:
      variables: {}
      nodes:
        experience: { type: give-experience, amount: 25 }
      connections:
        enter: { from: $event.exec, to: experience.exec }
        experience-player: { from: $event.player, to: experience.player }
on-complete:
  variables: {}
  nodes:
    remember: { type: set-flag, flag: helped_builder, value: true }
  connections:
    enter: { from: $event.exec, to: remember.exec }
    remember-player: { from: $event.player, to: remember.player }
# Lifecycle hooks are host-event graphs and run only after validation.
