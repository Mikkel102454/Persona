# A manually bound Citizens NPC remains the shared actor at the pier.
# The shared tree patrols it; the player tree can privately relocate or hide it.
content-version: 2
id: harbor:keeper
display-name: "<aqua>Keeper Mira"
shared-behavior: harbor:keeper-shared
player-behavior: harbor:keeper-player

anchors:
  pier: { world: world, x: 24, y: 64, z: -12, yaw: 90 }
  lighthouse: { world: world, x: 58, y: 70, z: -34, yaw: 180 }
  overlook: { world: world, x: 44, y: 76, z: -20, yaw: 135 }
  festival-square: { world: world, x: 8, y: 64, z: 16, yaw: 0 }

on-click:
  variables: {}
  nodes:
    greeting: { type: message, text: "<gray>Mira watches the horizon. Trust: <memory:trust>" }
  connections:
    enter: { from: $event.exec, to: greeting.exec }
    greeting-player: { from: $event.player, to: greeting.player }

on-no-dialogue:
  variables: {}
  nodes:
    hint: { type: message, text: "<gray>Try signaling kindness or festival-start through the API." }
  connections:
    enter: { from: $event.exec, to: hint.exec }
    hint-player: { from: $event.player, to: hint.player }
