content-version: 2
id: guild:trial_intro
start: offer
nodes:
  offer:
    graph:
      variables: {}
      nodes:
        sound: { type: play-sound, sound: minecraft:entity.villager.celebrate }
        welcome: { type: say, text: "Welcome, recruit. Are you ready for the Adventurer's Trial?" }
        courage:
          type: say
          variants:
            - { text: "Courage will carry you far.", weight: 2 }
            - { text: "Keep your eyes open out there.", weight: 1 }
        answer:
          type: choice
          options:
            - { text: "I am ready." }
            - { text: "Maybe later." }
        start: { type: start-quest, quest: guild:adventurers_trial }
        accepted: { type: goto, node: accepted }
        decline: { type: end-dialogue }
      connections:
        enter: { from: $event.exec, to: sound.exec }
        sound-player: { from: $event.player, to: sound.player }
        welcome: { from: sound.success, to: welcome.exec }
        courage: { from: welcome.success, to: courage.exec }
        choose: { from: courage.success, to: answer.exec }
        start: { from: answer.option-0, to: start.exec }
        start-player: { from: $event.player, to: start.player }
        accepted: { from: start.success, to: accepted.exec }
        decline: { from: answer.option-1, to: decline.exec }
  accepted:
    graph:
      variables: {}
      nodes:
        line: { type: say, text: "Begin by collecting three loaves of bread." }
        end: { type: end-dialogue }
      connections:
        enter: { from: $event.exec, to: line.exec }
        finish: { from: line.success, to: end.exec }
