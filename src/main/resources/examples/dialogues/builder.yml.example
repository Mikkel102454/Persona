content-version: 2
id: village:builder_intro
start: greeting
nodes:
  greeting:
    graph:
      variables: {}
      nodes:
        hello: { type: say, text: "Hello there! I'm repairing the village workshop.", delay: 1.5s }
        ask: { type: say, text: "Could you bring me ten oak logs?" }
        answer:
          type: choice
          options:
            - { text: "Of course. I'll get the logs." }
            - { text: "I can't help right now." }
        start: { type: start-quest, quest: village:supplies }
        accepted: { type: goto, node: accepted }
        decline: { type: end-dialogue }
      connections:
        enter: { from: $event.exec, to: hello.exec }
        ask: { from: hello.success, to: ask.exec }
        choose: { from: ask.success, to: answer.exec }
        accept: { from: answer.option-0, to: start.exec }
        start-player: { from: $event.player, to: start.player }
        started: { from: start.success, to: accepted.exec }
        reject: { from: answer.option-1, to: decline.exec }
  accepted:
    graph:
      variables: {}
      nodes:
        thanks: { type: say, text: "Thank you! Come back when you have all ten." }
        end: { type: end-dialogue }
      connections:
        enter: { from: $event.exec, to: thanks.exec }
        finish: { from: thanks.success, to: end.exec }
# Node scripts are explicit, typed graphs with stable node and connection IDs.
